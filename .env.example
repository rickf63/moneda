# Copia este archivo a ".env" (cp .env.example .env / copy .env.example .env)
# El archivo .env NUNCA debe subirse a GitHub -- ya está en .gitignore

# RPC endpoint de Sepolia. Este es público y no requiere registro:
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Dirección de tu contrato MiToken ya desplegado en Sepolia
CONTRACT_ADDRESS=0xfE32dA5475A56091344dD43Ab074Ca033F5A8EDD

# Bloque donde se desplegó el contrato (evita escanear toda la blockchain al buscar transfers)
DEPLOY_BLOCK=11484102

# --- Config de red (para el botón de Conectar Wallet) ---
# Sepolia (default): CHAIN_ID=11155111, EXPLORER_BASE_URL=https://sepolia.etherscan.io
# Mainnet real:       CHAIN_ID=1,        EXPLORER_BASE_URL=https://etherscan.io
CHAIN_ID=11155111
NETWORK_NAME=Sepolia
EXPLORER_BASE_URL=https://sepolia.etherscan.io

# Opcional: dirección del contrato TokenSale, si ya desplegaste uno.
# Déjala vacía y la sección "Comprar Tokens" simplemente no aparece.
TOKENSALE_ADDRESS=
