# Copia este archivo a ".env" (cp .env.example .env / copy .env.example .env)
# El archivo .env NUNCA debe subirse a GitHub -- ya está en .gitignore
#
# Valores por default: Ethereum mainnet (contratos reales del proyecto).
# Para usar Sepolia (testnet) cambia los valores marcados abajo.

# RPC endpoint público (no requiere registro).
# Sepolia: https://ethereum-sepolia-rpc.publicnode.com
RPC_URL=https://ethereum-rpc.publicnode.com

# Dirección del contrato MiToken (MTK)
CONTRACT_ADDRESS=0xfE32dA5475A56091344dD43Ab074Ca033F5A8EDD

# Bloque donde se desplegó el contrato (evita escanear toda la blockchain al buscar transfers)
# Sepolia: 11484102
DEPLOY_BLOCK=26042897

# --- Config de red (para el botón de Conectar Wallet) ---
# Mainnet: CHAIN_ID=1,        EXPLORER_BASE_URL=https://etherscan.io
# Sepolia: CHAIN_ID=11155111, EXPLORER_BASE_URL=https://sepolia.etherscan.io
CHAIN_ID=1
NETWORK_NAME=Ethereum Mainnet
EXPLORER_BASE_URL=https://etherscan.io

# Opcional: dirección del contrato TokenSale.
# Déjala vacía y la sección "Comprar tokens" simplemente no aparece.
TOKENSALE_ADDRESS=0x5B9Fc968C5A023C0093e8Da5B6C57f59e3311587

# Opcional: cuántos tramos de 5,000 bloques revisa hacia atrás el dashboard
# al buscar transfers (40 = ~28 días en mainnet).
# MAX_SCAN_CHUNKS=40
